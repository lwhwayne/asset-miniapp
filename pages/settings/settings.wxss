.title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.desc {
  margin-bottom: 24rpx;
  line-height: 1.6;
  font-size: 26rpx;
}

textarea {
  box-sizing: border-box;
  width: 100%;
  height: 260rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #f7f8fb;
  color: #111827;
  font-size: 26rpx;
}

.action-button,
.danger-button {
  margin-top: 24rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.danger-card {
  border: 1rpx solid #ffe4e6;
}

.danger-button {
  background: #fff1f2;
  color: #e11d48;
}
