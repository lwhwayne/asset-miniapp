<view class="page">
  <view class="card form-card">
    <view class="field">
      <view class="label">资产名称</view>
      <input value="{{form.name}}" placeholder="例如：支付宝余额" data-field="name" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">资产分类</view>
      <picker mode="selector" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">{{categoryNames[categoryIndex]}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">币种</view>
      <picker mode="selector" range="{{currencyNames}}" value="{{currencyIndex}}" bindchange="onCurrencyChange">
        <view class="picker-value">{{currencyNames[currencyIndex]}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">原币金额</view>
      <input type="digit" value="{{form.amount}}" placeholder="0.00" data-field="amount" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">兑人民币汇率</view>
      <input type="digit" value="{{form.exchangeRateToCny}}" placeholder="1.00" data-field="exchangeRateToCny" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">备注</view>
      <textarea value="{{form.note}}" placeholder="可记录账户说明或保单信息" data-field="note" bindinput="onInput" />
    </view>
  </view>

  <button class="button-primary save-button" bindtap="saveAsset">保存资产</button>
  <button wx:if="{{form.id}}" class="delete-button" bindtap="confirmDelete">删除资产</button>
</view>
