.hero-card {
  margin-bottom: 24rpx;
  padding: 40rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1f6feb, #60a5fa);
  color: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(31, 111, 235, 0.24);
}

.hero-card .muted {
  color: rgba(255, 255, 255, 0.78);
}

.total {
  margin-top: 14rpx;
  font-size: 56rpx;
  font-weight: 800;
}

.delta {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
}

.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.quick-actions button {
  flex: 1;
  font-size: 28rpx;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.section-header,
.legend-row,
.legend-left,
.ratio-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chart {
  width: 100%;
  height: 220px;
}

.legend-row,
.ratio-row {
  margin-top: 18rpx;
  color: #4b5563;
  font-size: 26rpx;
}

.legend-left {
  justify-content: flex-start;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 14rpx;
  border-radius: 50%;
}

.ratio-track {
  overflow: hidden;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: #edf0f5;
}

.ratio-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #1f6feb;
}

.ratio-value {
  margin-top: 10rpx;
  color: #7a8499;
  font-size: 24rpx;
}

.link {
  color: #1f6feb;
  font-size: 26rpx;
}

.empty-small {
  padding: 24rpx 0;
  color: #7a8499;
  text-align: center;
  font-size: 26rpx;
}
