page {
  min-height: 100vh;
  background: #f7f8fb;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
}

.card {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(31, 41, 55, 0.06);
}

.muted {
  color: #7a8499;
}

.button-primary {
  border-radius: 999rpx;
  background: #1f6feb;
  color: #ffffff;
}

.button-secondary {
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1f6feb;
}

.empty {
  padding: 60rpx 24rpx;
  text-align: center;
  color: #7a8499;
}
